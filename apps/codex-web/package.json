{
	"name": "@hostc/codex-web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"fixture": "vite build && HOSTC_CODEX_BIN=$PWD/dev/fixture-codex.mjs node ../cli/dev/fixture-server.ts",
		"generate:protocol": "rm -rf src/codex/protocol && codex app-server generate-ts --experimental --out src/codex/protocol"
	},
	"dependencies": {
		"@solidjs/router": "2.0.0-next.43",
		"@solidjs/web": "2.0.0-rc.20",
		"@stylexjs/stylex": "0.19.1",
		"solid-js": "2.0.0-rc.20"
	},
	"devDependencies": {
		"@solidjs/diagnostics": "2.0.0-rc.20",
		"@solidjs/vite-plugin": "3.0.0-next.54",
		"@stylexjs/unplugin": "0.19.1",
		"filesystem-routing": "0.4.2",
		"typescript": "^7.0.2",
		"unplugin": "3.7.0",
		"vite": "8.3.5"
	},
	"browserslist": [
		"baseline widely available"
	]

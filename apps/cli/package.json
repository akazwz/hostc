{
	"name": "hostc",
	"version": "2.0.6",
	"description": "Give your dev server a public HTTPS URL in one command. WebSockets and hot reload included.",
	"keywords": [
		"cli",
		"dev-server",
		"hmr",
		"hot-reload",
		"http",
		"localhost",
		"ngrok-alternative",
		"tunnel",
		"websocket"
	],
	"homepage": "https://hostc.dev",
	"bugs": {
		"url": "https://github.com/akazwz/hostc/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/akazwz/hostc.git",
		"directory": "apps/cli"
	},
	"bin": {
		"hostc": "./dist/hostc.mjs"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"prepack": "pnpm build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --exclude test/e2e.test.ts",
		"test:e2e": "vitest run test/e2e.test.ts"
	},
	"dependencies": {
		"uqr": "^0.1.3",
		"ws": "^8.22.0"
	},
	"devDependencies": {
		"@hostc/client": "workspace:*",
		"@hostc/protocol": "workspace:*",
		"@types/ws": "^8.18.2",
		"tsdown": "^0.23.0"
	},
	"engines": {
		"node": ">=22"
	}
}
